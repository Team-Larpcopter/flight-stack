<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>larp_liteanystereo</name>
  <version>0.1.0</version>
  <description>Lite Any Stereo V2 (LAS2) stereo depth on the Jetson with TensorRT: ONNX export, engine build and launch, running on larp_neural_depth's TensorRT stereo node.</description>
  <maintainer email="team@larpcopter.local">Team Larpcopter</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>larp_neural_depth</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
